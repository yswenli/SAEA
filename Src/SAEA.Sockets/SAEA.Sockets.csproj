<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>26.11.5.1</Version>
    <Authors>yswenli</Authors>
    <Description>SAEA.Socket is a cross-platform high-performance Socket framework based on .NET Standard 2.0; Src contains its application test scenarios, such as websocket, rpc, redis driver, MVC WebAPI, lightweight message server, ultra large file transmission, etc.
SAEA.Socket是一个跨平台高性能 Socket 框架，基于 .NET Standard 2.0；Src 中含有其应用测试场景，例如 websocket、rpc、redis 驱动、MVC WebAPI、轻量级消息服务器、超大文件传输等
https://github.com/yswenli/SAEA</Description>
    <Copyright>yswenli</Copyright>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yswenli/SAEA</PackageProjectUrl>
    <PackageIconUrl></PackageIconUrl>
    <RepositoryUrl>https://github.com/yswenli/SAEA</RepositoryUrl>
    <PackageTags>cross-platform,tcp,udp,socket</PackageTags>
    <PackageReleaseNotes>SAEA.Socket is a cross-platform high-performance Socket framework based on .NET Standard 2.0; Src contains its application test scenarios, such as websocket, rpc, redis driver, MVC WebAPI, lightweight message server, ultra large file transmission, etc.
SAEA.Socket是一个跨平台高性能 Socket 框架，基于 .NET Standard 2.0；Src 中含有其应用测试场景，例如 websocket、rpc、redis 驱动、MVC WebAPI、轻量级消息服务器、超大文件传输等
https://github.com/yswenli/SAEA</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <LangVersion>8.0</LangVersion>
    <PackageIcon>favicon.png</PackageIcon>
    <SignAssembly>False</SignAssembly>
    <AssemblyOriginatorKeyFile>E:\Work\SAEA\Src\SAEA.Sockets.pfx</AssemblyOriginatorKeyFile>
    <Title>$(AssemblyName)</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAEA.Common\SAEA.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\favicon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pipelines.Sockets.Unofficial" Version="2.2.16" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
